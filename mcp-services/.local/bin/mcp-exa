#!/usr/bin/env bash
# Shared local HTTP MCP endpoint for Exa web search and page fetching.
set -euo pipefail

exec uvx --from 'mcp-proxy==0.12.0' --with 'mcp==1.29.0' mcp-proxy \
  --port 8769 --host 127.0.0.1 \
  --allow-origin http://127.0.0.1:3002 http://localhost:3002 -- \
  "${HOME}/.local/bin/mcp-exa-stdio"
