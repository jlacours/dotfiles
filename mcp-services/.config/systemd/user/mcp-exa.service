[Unit]
Description=Shared Exa web search MCP server (local HTTP on 127.0.0.1:8769)
PartOf=mcp-llama.target
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/mcp-exa
Restart=on-failure
RestartSec=3
IPAddressDeny=100.64.0.0/10
IPAddressDeny=fd7a:115c:a1e0::/48

[Install]
WantedBy=mcp-llama.target
