[Unit]
Description=Privacy-safe local AI usage sampler
After=default.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.config/quickshell/hyprbar/usage-data.py --collect-local
Restart=on-failure
RestartSec=15s
TimeoutStopSec=5s
Nice=10
IOSchedulingClass=idle
UMask=0077
StandardOutput=null
StandardError=journal

[Install]
WantedBy=default.target
