# Layout is static; colors are generated by Wallust at ~/.config/mako/wallust.conf.
include=~/.config/mako/wallust.conf
font=Comic Code 10
border-size=2
padding=8
margin=6
default-timeout=6000
max-visible=5
anchor=bottom-right
# Keep clear of the 32px taskbar.
outer-margin=40

[urgency=critical]
default-timeout=0

[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb urgency=critical]
invisible=0
