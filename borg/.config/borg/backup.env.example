# Copy this file to ~/.config/borg/backup.env and keep that copy out of Git.
# Shell quoting is supported because borg-backup sources the file.

BORG_REPO=/path/to/borg-repository
BORG_PASSCOMMAND="cat $HOME/.config/borg/passphrase"
BORG_SOURCE="$HOME"
BORG_ARCHIVE_PREFIX=home
BORG_COMPRESSION=lz4
BORG_KEEP_DAILY=7
BORG_KEEP_WEEKLY=4
BORG_KEEP_MONTHLY=6
BORG_MIN_FREE_GIB=5
BORG_ONE_FILE_SYSTEM=1
# Temporarily disable both normal archive rotation and automatic checkpoint
# cleanup while recovering data from an interrupted archive.
# BORG_PRUNE=0

# Strongly recommended for local removable or secondary filesystems. This
# prevents an unmounted disk from turning the repository path into a directory
# on the root filesystem.
BORG_EXPECTED_MOUNT=/path/to/backup-mount

# Optional executable invoked before Borg, for example a machine-local system
# configuration snapshot helper. Do not place privileged or identifying
# details in the tracked script.
# BORG_PRE_BACKUP_COMMAND="$HOME/.local/bin/snapshot-system-config"
