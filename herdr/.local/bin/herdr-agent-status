#!/usr/bin/env python3
"""Print a compact, one-line summary of Herdr agent states."""

import json
import os
import shutil
import subprocess
import sys
import time
import unicodedata


STATUS_MARKS = {
    "blocked": "!",
    "done": "✓",
    "idle": "○",
    "unknown": "?",
}
WORKING_FRAMES = "◐◓◑◒"
MAX_AGENTS = 8
MAX_LABEL_LENGTH = 12
STATUS_ORDER = {"blocked": 0, "working": 1, "done": 2, "unknown": 3, "idle": 4}


def clean_label(value):
    if not isinstance(value, str):
        return "agent"
    label = "".join(
        character
        for character in value
        if unicodedata.category(character)[0] != "C"
    ).strip()
    return " ".join(label.split())[:MAX_LABEL_LENGTH] or "agent"


def main():
    try:
        result = subprocess.run(
            [os.environ.get("HERDR_BIN_PATH") or shutil.which("herdr") or os.path.expanduser("~/.local/bin/herdr"), "agent", "list"],
            check=True,
            capture_output=True,
            text=True,
            timeout=1.5,
        )
        response = json.loads(result.stdout)
        if not isinstance(response, dict):
            return 0
        result_data = response.get("result", response)
        if not isinstance(result_data, dict):
            return 0
        agents = result_data.get("agents", [])
        if not isinstance(agents, list) or not agents:
            return 0

        agents = [item for item in agents if isinstance(item, dict)]
        agents.sort(key=lambda item: (
            item.get("focused") is not True,
            STATUS_ORDER.get(str(item.get("agent_status")), 3),
        ))
        entries = []
        working_mark = WORKING_FRAMES[int(time.time()) % len(WORKING_FRAMES)]
        for item in agents[:MAX_AGENTS]:
            label = clean_label(item.get("name") or item.get("display_agent") or item.get("agent"))
            status = item.get("agent_status", "unknown")
            if not isinstance(status, str):
                status = "unknown"
            mark = working_mark if status == "working" else STATUS_MARKS.get(status, "?")
            # Keep symbol-font glyphs away from the terminal's right edge and
            # leave an empty cell beside them for wider fallback-font ink.
            entry = f"{mark} {label}"
            if item.get("focused") is True:
                entry = f"[{entry}]"
            entries.append(entry)

        if len(agents) > MAX_AGENTS:
            entries.append(f"+{len(agents) - MAX_AGENTS}")
        print(" · ".join(entries))
        return 0
    except (OSError, subprocess.SubprocessError, ValueError, KeyError, TypeError):
        return 0


if __name__ == "__main__":
    sys.exit(main())
