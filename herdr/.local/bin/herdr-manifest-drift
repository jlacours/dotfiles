#!/usr/bin/env python3
"""Report local Herdr detection overrides whose upstream manifest has moved on.

A local override in ~/.config/herdr/agent-detection shadows the remote manifest
Herdr caches in ~/.local/state/herdr/agent-detection/remote. Each override's
first line names the remote version it was based on:

    # Local override of remote Muse manifest 2026.08.26.1. ...

Exit status is 1 when any override is behind its cached remote, else 0.
"""

import os
import re
import sys
import tomllib

LOCAL_DIR = os.path.expanduser("~/.config/herdr/agent-detection")
REMOTE_DIR = os.path.expanduser("~/.local/state/herdr/agent-detection/remote")
BASE_RE = re.compile(r"manifest\s+(\d{4}\.\d{2}\.\d{2}\.\d+)")


def version_key(version):
    return tuple(int(part) for part in version.split("."))


def main():
    stale = False
    for name in sorted(os.listdir(LOCAL_DIR)):
        if not name.endswith(".toml"):
            continue
        with open(os.path.join(LOCAL_DIR, name), encoding="utf-8") as handle:
            match = BASE_RE.search(handle.readline())
        base = match.group(1) if match else None
        remote_path = os.path.join(REMOTE_DIR, name)
        if not os.path.exists(remote_path):
            print(f"{name}: no cached remote manifest")
            continue
        with open(remote_path, "rb") as handle:
            remote = str(tomllib.load(handle).get("version", ""))
        if base is None:
            print(f"{name}: header names no base version; remote is {remote}")
        elif version_key(remote) > version_key(base):
            stale = True
            print(f"{name}: STALE, based on {base}, upstream now {remote}")
        else:
            print(f"{name}: current, based on {base}")
    return 1 if stale else 0


if __name__ == "__main__":
    sys.exit(main())
