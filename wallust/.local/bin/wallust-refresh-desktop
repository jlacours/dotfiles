#!/usr/bin/env bash
# Refresh desktop components that do not watch Wallust outputs themselves.
set -u

# GTK only reads its user CSS when the process starts or its base theme changes.
# Pulse between the installed adw-gtk3 variants so already-running GTK3 clients
# (including LibreWolf's native file chooser) reparse Wallust's freshly generated
# gtk.css, then leave the session on the maintained dark base theme.
if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface color-scheme prefer-dark >/dev/null 2>&1 || true
    gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3 >/dev/null 2>&1 || true
    gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3-dark >/dev/null 2>&1 || true
fi

if pgrep -x qtile >/dev/null 2>&1; then
    qtile shell -c 'reload_config()' >/dev/null 2>&1 || true
fi

if pgrep -x mako >/dev/null 2>&1; then
    makoctl reload >/dev/null 2>&1 || true
fi
